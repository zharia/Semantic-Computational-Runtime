{
  "$id": "SDP-GRAPH-SCHEMA-001",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SDP Library Graph Schema",
  "type": "object",
  "required": ["schema_version", "graph_id", "nodes", "edges"],
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version identifier"
    },
    "graph_id": {
      "type": "string",
      "description": "Graph identifier"
    },
    "generated_from": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Source files that contributed to this graph"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name"],
        "properties": {
          "id": { "type": "string", "description": "Node identifier" },
          "type": { "type": "string", "description": "Node type (project, application, adoption_event, knowledge_base)" },
          "name": { "type": "string", "description": "Human-readable name" },
          "path": { "type": "string", "description": "Filesystem path to related material" }
        },
        "additionalProperties": false
      },
      "description": "List of graph nodes"
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "relationship"],
        "properties": {
          "source": { "type": "string", "description": "Source node id" },
          "target": { "type": "string", "description": "Target node id" },
          "relationship": {
            "type": "string",
            "enum": ["CONTAINS", "DEPENDS_ON", "REFERENCES", "DERIVES_FROM"],
            "description": "Relationship type from controlled vocabulary"
          }
        },
        "additionalProperties": false
      },
      "description": "List of graph edges"
    }
  },
  "additionalProperties": false
}