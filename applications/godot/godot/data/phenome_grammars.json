  "semantics": {
    "stage": "stage_for_age(species, age) = min(stage_max, floor(age / (maturity[stage_max] / stage_max))) = max s in 0..stage_max with maturity[s] <= age (monotone, bounded)",
    "depth": "depth = stage_depths[stage]; derivation = axiom followed by exactly `depth` simultaneous replacement steps (parallel, context-free)",
    "modulation": "trait_milli = clamp(floor(trait * trait_quant), 0, trait_quant); modulated = (base * trait_quant + delta * trait_milli) / trait_quant (exact rational); traits = [ash_tolerance, drought_tolerance] (milestone 0009 trait vector order)",
    "variant": "axiom parameter 0 gains (variant_seed mod axiom_jitter_mod) before derivation begins (variability declared in the grammar \u2014 SCR-LIB-MORPHOLOGY-PROCEDURAL 1.6)",
