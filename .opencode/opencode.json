{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "plugin": [],
  "lsp": {
    "mojo": {
      "command": [
        "/home/zharia/Projects/experiments/semantic_computational_runtime/.venv/bin/mojo-lsp-server",
        "-I",
        "/home/zharia/Projects/experiments/semantic_computational_runtime/runtime/HyrxMQ/src",
        "-I",
        "/home/zharia/Projects/experiments/semantic_computational_runtime/runtime/HyrxMQ/vendor/flare"
      ],
      "extensions": [".mojo"]
    }
  },
  "mcp": {
    "lean-lsp": {
      "type": "local",
      "command": ["uvx", "lean-lsp-mcp"],
      "cwd": "/home/zharia/Projects/experiments/semantic_computational_runtime",
      "environment": {
        "PATH": "/home/zharia/.elan/bin:/home/zharia/.local/bin:/usr/local/bin:/usr/bin:/bin"
      },
      "enabled": true,
      "timeout": 120000
    },
    "iac": {
      "type": "local",
      "command": [
        "/home/zharia/.local/share/iac-mcp/venv/bin/python",
        "-m",
        "iac.mcp_server"
      ],
      "cwd": "/home/zharia/Projects/experiments/semantic_computational_runtime/runtime/HyrxMQ/tools/inter_agent_com",
      "environment": {
        "PYTHONPATH": "/home/zharia/Projects/experiments/semantic_computational_runtime/runtime/HyrxMQ/tools/inter_agent_com"
      },
      "enabled": true,
      "timeout": 60000
    }
  },
  "skills": {
    "paths": [
      "./skills/asd-ste100",
      "./skills/scr-new-domain",
      "./skills/scr-edit-domain",
      "./skills/scr-meta-edit"
    ]
  },
  "tmpDir": "./.tmp",
  "tmpWorkspace": {
    "/tmp/**": "allow"
  }
}
